{
  "comments": { "lineComment": "//" },
  "brackets": [["{", "}"], ["(", ")"], ["[", "]"]],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [["{", "}"], ["(", ")"], ["\"", "\""]],
  "indentationRules": { "increaseIndentPattern": "\\{\\s*$", "decreaseIndentPattern": "^\\s*\\}" },
  "onEnterRules": [],
  "wordPattern": "[\\p{L}_][\\p{L}\\p{N}_]*(?:\\.[\\p{L}_][\\p{L}\\p{N}_]*)*"
}
